{
  "Name": "yft sandbox",
  "Description": "macOS Stream Deck utilities: Media controls and Mic Mute (0% / 100%)",
  "Author": "toumorokoshi",
  "Version": "1.0.0",
  "Icon": "icons/plugin",
  "Category": "yft sandbox",
  "CategoryIcon": "icons/plugin",
  "CodePaths": {
    "x86_64-apple-darwin": "bin/macos-media",
    "aarch64-apple-darwin": "bin/macos-media"
  },
  "CodePathMac": "bin/macos-media",
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "10.15"
    }
  ],
  "Actions": [
    {
      "UUID": "com.toumorokoshi.yftsandbox.micmute",
      "Name": "Mic Mute (0% / 100%)",
      "Icon": "icons/mic_on",
      "Tooltip": "Toggle microphone input volume between 0% (Muted) and 100% (Live)",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "icons/mic_on",
          "TitleAlignment": "bottom",
          "Name": "Live"
        },
        {
          "Image": "icons/mic_off",
          "TitleAlignment": "bottom",
          "Name": "Muted"
        }
      ]
    },
    {
      "UUID": "com.toumorokoshi.yftsandbox.playpause",
      "Name": "Play / Pause",
      "Icon": "icons/playpause",
      "Tooltip": "Toggle play/pause for macOS media",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "icons/play",
          "TitleAlignment": "bottom",
          "Name": "Play"
        },
        {
          "Image": "icons/pause",
          "TitleAlignment": "bottom",
          "Name": "Pause"
        }
      ]
    },
    {
      "UUID": "com.toumorokoshi.yftsandbox.play",
      "Name": "Play",
      "Icon": "icons/play",
      "Tooltip": "Start or resume media playback",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "icons/play",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "UUID": "com.toumorokoshi.yftsandbox.pause",
      "Name": "Pause",
      "Icon": "icons/pause",
      "Tooltip": "Pause media playback",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "icons/pause",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "UUID": "com.toumorokoshi.yftsandbox.next",
      "Name": "Next Track",
      "Icon": "icons/next",
      "Tooltip": "Skip to next track",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "icons/next",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "UUID": "com.toumorokoshi.yftsandbox.previous",
      "Name": "Previous Track",
      "Icon": "icons/previous",
      "Tooltip": "Return to previous track",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "icons/previous",
          "TitleAlignment": "bottom"
        }
      ]
    }
  ]
}
